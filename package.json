{
  "name": "jrs",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "turbo run check-types",
    "audit": "pnpm audit --prod",
    "desktop": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 pnpm --filter @jrs/desktop tauri dev",
    "mobile": "pnpm --filter @jrs/mobile start",
    "android": "pnpm --filter @jrs/mobile android",
    "android:dev": "pnpm --filter @jrs/mobile android:dev",
    "android:build": "pnpm --filter @jrs/mobile android:build",
    "server": "pnpm --filter @jrs/server start:dev",
    "backend": "pnpm --filter @jrs/server start:dev",
    "intake": "pnpm --filter @jrs/intake dev",
    "maildev": "maildev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
