{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LRC JRS",
  "version": "0.0.1",
  "identifier": "com.ngangman-teddy.lrc-jrs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LRC JRS - Youth Fellowship Portal",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDNTJERUJCMUYzQzk0MzMKUldRemxEd2Z1OTVTSENYbHNPSzZjK1BiRVFQR0NoQkNZNy9hcGljU2tickFNNEluV1BYZDl1Y0UK",
      "endpoints": [
        "https://github.com/N-Teddy/lrc-jrs/releases/latest/download/latest.json"
      ]
    }
  }
}
