<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>Bienvenue sur LRC JRS - Vos accès à la plateforme</title>
  <style>
    /* Reset & Base Styles */
    body, table, td, p, a, li, blockquote {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      background-color: #faf7f2;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1e1b19;
      line-height: 1.6;
    }
    /* Responsive */
    @media screen and (max-width: 600px) {
      .email-container {
        width: 100% !important;
        margin: auto !important;
        border-radius: 0 !important;
      }
      .content-padding {
        padding: 24px 20px !important;
      }
      .header-padding {
        padding: 24px 20px 20px 20px !important;
      }
      .temp-code {
        font-size: 20px !important;
        letter-spacing: 2px !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #faf7f2;">
  <!-- Email Outer Wrapper -->
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #faf7f2;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <!-- Email Container (max 560px) -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 560px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e8e1dd; overflow: hidden; box-shadow: 0 4px 16px rgba(30, 27, 25, 0.05);">
          
          <!-- Brand Top Accent Bar -->
          <tr>
            <td height="4" style="background-color: #b85028; line-height: 4px; font-size: 4px;">&nbsp;</td>
          </tr>

          <!-- Header -->
          <tr>
            <td class="header-padding" style="padding: 32px 32px 24px 32px; border-bottom: 1px solid #f4ece9;">
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td>
                    <!-- Pill Category Badge -->
                    <span style="display: inline-block; padding: 3px 8px; font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #b85028; background-color: #fff2ee; border: 1px solid #ffdbcf; border-radius: 4px; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                      LRC · Youth Community Platform
                    </span>
                    <h1 style="margin: 12px 0 4px 0; font-size: 21px; font-weight: 800; color: #1e1b19; letter-spacing: -0.3px; line-height: 1.3;">
                      Vos accès à la plateforme
                    </h1>
                    <p style="margin: 0; font-size: 13px; color: #8a726a; line-height: 1.4;">
                      Bienvenue ! Votre compte utilisateur a été activé avec succès.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Main Body Content -->
          <tr>
            <td class="content-padding" style="padding: 28px 32px;">
              <p style="margin: 0 0 14px 0; font-size: 15px; font-weight: 700; color: #1e1b19;">
                Bonjour {{fullName}},
              </p>
              <p style="margin: 0 0 16px 0; font-size: 13.5px; color: #57423b; line-height: 1.6;">
                Votre compte d'accès pour l'application LRC JRS a été configuré par l'administration.
              </p>
              <p style="margin: 0 0 20px 0; font-size: 13.5px; color: #57423b; line-height: 1.6;">
                Voici votre mot de passe temporaire à usage unique pour effectuer votre première connexion :
              </p>

              <!-- Credentials Card -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #faf2ee; border: 1px solid #e8e1dd; border-radius: 8px; margin: 20px 0 24px 0;">
                <tr>
                  <td align="center" style="padding: 24px 20px;">
                    <div style="font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #8a726a; margin-bottom: 10px;">
                      Mot de passe temporaire
                    </div>
                    <div style="display: inline-block; background-color: #ffffff; border: 1px solid #ffb59c; border-radius: 6px; padding: 8px 18px; margin-bottom: 10px;">
                      <span class="temp-code" style="font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; font-size: 22px; font-weight: 800; letter-spacing: 2px; color: #1e1b19;">
                        {{tempPassword}}
                      </span>
                    </div>
                    <div style="font-size: 12px; font-weight: 600; color: #ba1a1a;">
                      ⚠️ Ce mot de passe temporaire expire dans {{expiresInHours}} heures.
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Notice on First Login -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #fff8f5; border: 1px solid #ffdbcf; border-left: 3px solid #b85028; border-radius: 4px; margin-bottom: 24px;">
                <tr>
                  <td style="padding: 12px 14px; font-size: 12.5px; color: #812901; line-height: 1.5;">
                    <strong style="color: #b85028;">Information importante :</strong> Lors de votre première connexion, il vous sera demandé de définir votre mot de passe personnel et définitif.
                  </td>
                </tr>
              </table>

              {{#if loginUrl}}
              <!-- Action Button CTA -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0;">
                <tr>
                  <td align="center">
                    <a href="{{loginUrl}}" target="_blank" style="display: inline-block; background-color: #b85028; color: #ffffff; text-decoration: none; font-size: 13.5px; font-weight: 700; padding: 12px 28px; border-radius: 6px; box-shadow: 0 2px 4px rgba(184, 80, 40, 0.2); letter-spacing: 0.2px;">
                      Accéder à l'application &rarr;
                    </a>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Sign-off -->
              <p style="margin: 0; font-size: 13.5px; color: #57423b; line-height: 1.6;">
                Cordialement,<br>
                <strong style="color: #1e1b19; font-weight: 700;">L'équipe d'administration LRC JRS</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 22px 32px; background-color: #faf7f2; border-top: 1px solid #e8e1dd; text-align: center;">
              <p style="margin: 0 0 6px 0; font-size: 11px; color: #8a726a; line-height: 1.4;">
                Ceci est une notification automatique sécurisée transmise par la plateforme LRC JRS.
              </p>
              <p style="margin: 0; font-size: 11px; font-weight: 600; color: #8a726a;">
                &copy; 2026 LRC Youth Community Platform · Cameroun
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
