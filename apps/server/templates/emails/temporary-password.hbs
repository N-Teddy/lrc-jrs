<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>Vos accès à la plateforme - LRC JRS</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    body, table, td, p, a, li, blockquote {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      background-color: #faf7f2;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1e1b19;
      line-height: 1.5;
    }
    .temp-code {
      user-select: all;
      -webkit-user-select: all;
    }
    @media screen and (max-width: 520px) {
      .email-card {
        width: 100% !important;
        border-radius: 8px !important;
        border-left: 0 !important;
        border-right: 0 !important;
      }
      .card-content {
        padding: 32px 20px 28px 20px !important;
      }
      .temp-code {
        font-size: 18px !important;
        letter-spacing: 1px !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #faf7f2;">
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #faf7f2; min-height: 100vh;">
    <tr>
      <td align="center" style="padding: 40px 16px;">
        
        <!-- Main Email Card -->
        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-card" style="max-width: 460px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e8e1dd; box-shadow: 0 2px 10px rgba(30, 27, 25, 0.04); overflow: hidden;">
          
          <!-- Top Terracotta Accent -->
          <tr>
            <td height="3" style="background-color: #b85028; line-height: 3px; font-size: 3px;">&nbsp;</td>
          </tr>

          <!-- Content Padding -->
          <tr>
            <td class="card-content" style="padding: 36px 36px 32px 36px; text-align: center;">
              
              <!-- Brand Logo -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td align="center" style="padding-bottom: 24px;">
                    <img src="{{#if logoUrl}}{{logoUrl}}{{else}}assets/logo.png{{/if}}" alt="LRC Youth Community" width="130" style="display: block; width: 130px; max-width: 130px; height: auto; border: 0; outline: none; margin: 0 auto;" />
                  </td>
                </tr>
              </table>

              <!-- Heading -->
              <h1 style="margin: 0 0 10px 0; font-size: 20px; font-weight: 700; color: #1e1b19; letter-spacing: -0.3px; line-height: 1.3;">
                Vos accès à la plateforme
              </h1>

              <!-- Direct Concise Lead -->
              <p style="margin: 0 0 24px 0; font-size: 13.5px; color: #57423b; line-height: 1.55;">
                Bonjour <strong style="color: #1e1b19; font-weight: 600;">{{fullName}}</strong>, votre compte a été activé. Voici votre mot de passe temporaire pour votre première connexion :
              </p>

              <!-- Prominent Temp Password Block -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #faf2ee; border: 1px solid #eddcd4; border-radius: 8px; margin: 0 0 22px 0;">
                <tr>
                  <td align="center" style="padding: 18px 16px;">
                    <div class="temp-code" id="temp-code" style="font-family: 'JetBrains Mono', SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; font-size: 21px; font-weight: 700; letter-spacing: 2px; color: #1e1b19; line-height: 1.2; user-select: all; -webkit-user-select: all; cursor: pointer;">
                      {{tempPassword}}
                    </div>
                    <div style="margin-top: 10px;">
                      <button type="button" class="copy-btn" onclick="copyToClipboard('{{tempPassword}}', this)" style="display: inline-block; padding: 4px 12px; background-color: #ffffff; border: 1px solid #eddcd4; border-radius: 4px; font-size: 11px; font-weight: 600; color: #8a726a; cursor: pointer; text-decoration: none; font-family: inherit;">
                        📋 Copier le mot de passe
                      </button>
                    </div>
                    <div style="margin-top: 8px; font-size: 12px; font-weight: 500; color: #8a726a;">
                      Expire dans {{expiresInHours}} heures
                    </div>
                  </td>
                </tr>
              </table>

              {{#if loginUrl}}
              <!-- Action Button CTA: Opens Desktop App or Web Portal -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 22px 0;">
                <tr>
                  <td align="center">
                    <a href="{{loginUrl}}" target="_blank" style="display: inline-block; background-color: #b85028; color: #ffffff; text-decoration: none; font-size: 13.5px; font-weight: 600; padding: 11px 26px; border-radius: 6px; letter-spacing: 0.2px;">
                      Se connecter à la plateforme &rarr;
                    </a>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Single First Login Reminder -->
              <p style="margin: 0 0 28px 0; font-size: 12px; color: #8a726a; line-height: 1.5;">
                Il vous sera demandé de définir votre mot de passe personnel dès votre connexion.
              </p>

              <!-- Subtle Divider & Micro Brand Footer -->
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-top: 1px solid #f2eae6;">
                <tr>
                  <td align="center" style="padding-top: 18px;">
                    <p style="margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; color: #a39089; text-transform: uppercase;">
                      LRC &bull; Youth Community Platform
                    </p>
                  </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

  <script>
    function copyToClipboard(text, btn) {
      if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          var original = btn.innerHTML;
          btn.innerHTML = "✓ Copié !";
          btn.style.borderColor = "#b85028";
          btn.style.color = "#b85028";
          setTimeout(function() {
            btn.innerHTML = original;
            btn.style.borderColor = "#eddcd4";
            btn.style.color = "#8a726a";
          }, 2000);
        });
      }
    }
  </script>
</body>
</html>
