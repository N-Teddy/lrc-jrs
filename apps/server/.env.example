# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api

# MongoDB
MONGODB_URI=mongodb://user:password@localhost:27017/lrc-jrs?authSource=admin

# JWT Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Google Drive (Service Account)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Custom WhatsApp API
WHATSAPP_API_BASE_URL=https://dash.jifihub.com/api/public/v1
WHATSAPP_API_KEY=

# SMTP Email Service (Use Maildev locally on localhost:1025 with Web UI at http://localhost:1080)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LRC JRS <noreply@lrcjrs.org>
